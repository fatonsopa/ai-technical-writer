{
  "schema_version": 1,
  "domains": [
    {
      "name": "writing-guidance",
      "purpose": "Document intent, format, language and coordinated writing procedures.",
      "owned_paths": [
        "SKILL.md",
        "references/",
        "examples/",
        "workflows/"
      ],
      "depends_on": []
    },
    {
      "name": "document-validation",
      "purpose": "Mechanical output structures and exact data checks.",
      "owned_paths": [
        "contracts/",
        "scripts/document_contracts.py",
        "scripts/plain_words.py",
        "scripts/zero_loss.py",
        "scripts/planning_readiness.py",
        "scripts/visual_contracts.py",
        "scripts/check_mermaid.mjs",
        "scripts/writing_style_contract.py",
        "scripts/continuation.py",
        "scripts/mermaid_runtime.mjs",
        "scripts/check_document.py",
        "scripts/title_contract.py"
      ],
      "depends_on": [
        "writing-guidance"
      ]
    },
    {
      "name": "document-delivery",
      "purpose": "Freeze source inputs, review judgments and deliver accepted bytes.",
      "owned_paths": [
        "scripts/validate_document.py",
        "scripts/rewrite_workflow.py"
      ],
      "depends_on": [
        "document-validation",
        "visual-rendering"
      ]
    },
    {
      "name": "behavioral-evaluation",
      "purpose": "Cases, fixtures, grades, bounded handoffs and honest quality summaries.",
      "owned_paths": [
        "evals/run.py",
        "evals/evaluation.py",
        "evals/grades.py",
        "evals/audit_examples.py",
        "evals/cases/",
        "evals/fixtures/",
        "evals/rubrics/",
        "evals/workflow_cases.json",
        "evals/style_cases.json",
        "evals/retry_cases.json",
        "evals/diagram_cases.json",
        "scripts/host_coverage.py",
        "config/host_validation.json",
        "scripts/provider_results.py",
        "evals/title_cases.json"
      ],
      "depends_on": [
        "document-delivery",
        "document-validation",
        "host-adapters",
        "repository"
      ]
    },
    {
      "name": "host-adapters",
      "purpose": "Transport optional provider invocations without owning acceptance rules.",
      "owned_paths": [
        "evals/adapters/"
      ],
      "depends_on": []
    },
    {
      "name": "repository",
      "purpose": "Root layout, dependency declarations, installation and integrity.",
      "owned_paths": [
        "scripts/repository_files.py",
        "scripts/repository_layout.py",
        "scripts/install_skill.py",
        "scripts/validate_skill.py",
        "scripts/smoke_check.py",
        "scripts/requirements.txt",
        "scripts/requirements-lock.txt"
      ],
      "depends_on": [
        "document-validation",
        "document-delivery"
      ]
    },
    {
      "name": "test-selection",
      "purpose": "Select impacted repository checks and gate final suites on explicit batch authorization.",
      "owned_paths": [
        "scripts/run_tests.py",
        "config/test_impact.json"
      ],
      "depends_on": [
        "repository"
      ]
    },
    {
      "name": "visual-rendering",
      "purpose": "Render diagrams with visible context, notation legends and source-bound exports.",
      "owned_paths": [
        "scripts/render_diagram.py",
        "scripts/diagram_presentation.py",
        "scripts/render_flowchart.py",
        "config/diagram_style.json",
        "scripts/diagram_components.py",
        "scripts/diagram_inventory.mjs",
        "scripts/audit_diagram.mjs",
        "scripts/check_diagram_collection.py"
      ],
      "depends_on": [
        "writing-guidance",
        "document-validation"
      ]
    }
  ]
}
